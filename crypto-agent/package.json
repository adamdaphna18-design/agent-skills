{
  "name": "crypto-agent",
  "version": "0.1.0",
  "description": "Telegram bot with GOAT on-chain tools (USDC on Base)",
  "type": "module",
  "main": "dist/bot.js",
  "scripts": {
    "dev": "tsx src/bot.ts",
    "build": "tsc",
    "start": "node dist/bot.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@goat-sdk/core": "latest",
    "@goat-sdk/plugin-erc20": "latest",
    "@goat-sdk/wallet-viem": "latest",
    "dotenv": "^16.4.5",
    "telegraf": "^4.16.3",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}